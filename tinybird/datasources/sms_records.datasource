DESCRIPTION > Raw MediaCore SMS XDR transaction records for Message Explorer and ANI analytics

SCHEMA >
    `dataset_id` UUID `json:$.dataset_id`,
    `upload_id` UUID `json:$.upload_id`,
    `batch_id` UInt32 `json:$.batch_id`,
    `message_row_id` UInt64 `json:$.message_row_id`,
    `row_hash` String `json:$.row_hash`,
    `event_timestamp` DateTime64(6, 'UTC') `json:$.event_timestamp`,
    `dlr_timestamp` Nullable(DateTime64(6, 'UTC')) `json:$.dlr_timestamp`,
    `dlr_latency_ms` Nullable(Int64) `json:$.dlr_latency_ms`,
    `op_name` LowCardinality(String) DEFAULT '' `json:$.op_name`,
    `tp_name` LowCardinality(String) DEFAULT '' `json:$.tp_name`,
    `applicant` LowCardinality(String) DEFAULT '' `json:$.applicant`,
    `direction` LowCardinality(String) DEFAULT '' `json:$.direction`,
    `route` LowCardinality(String) DEFAULT '' `json:$.route`,
    `op_ani` String DEFAULT '' `json:$.op_ani`,
    `tp_ani` String DEFAULT '' `json:$.tp_ani`,
    `destination_number` String DEFAULT '' `json:$.destination_number`,
    `called_number_out` String DEFAULT '' `json:$.called_number_out`,
    `message_id` String DEFAULT '' `json:$.message_id`,
    `transaction_id` String DEFAULT '' `json:$.transaction_id`,
    `country` LowCardinality(String) DEFAULT '' `json:$.country`,
    `state_region` LowCardinality(String) DEFAULT '' `json:$.state_region`,
    `raw_country_network` LowCardinality(String) DEFAULT '' `json:$.raw_country_network`,
    `op_mcc` LowCardinality(String) DEFAULT '' `json:$.op_mcc`,
    `op_mnc` LowCardinality(String) DEFAULT '' `json:$.op_mnc`,
    `tp_mcc` LowCardinality(String) DEFAULT '' `json:$.tp_mcc`,
    `tp_mnc` LowCardinality(String) DEFAULT '' `json:$.tp_mnc`,
    `raw_submit_status` LowCardinality(String) DEFAULT '' `json:$.raw_submit_status`,
    `raw_dlr_state` LowCardinality(String) DEFAULT '' `json:$.raw_dlr_state`,
    `raw_status` LowCardinality(String) DEFAULT '' `json:$.raw_status`,
    `normalized_status` LowCardinality(String) DEFAULT 'UNKNOWN' `json:$.normalized_status`,
    `is_terminal` UInt8 DEFAULT 0 `json:$.is_terminal`,
    `reason` LowCardinality(String) DEFAULT '' `json:$.reason`,
    `reason_normalized` LowCardinality(String) DEFAULT '' `json:$.reason_normalized`,
    `op_host` LowCardinality(String) DEFAULT '' `json:$.op_host`,
    `tp_host` LowCardinality(String) DEFAULT '' `json:$.tp_host`,
    `nas_ip` LowCardinality(String) DEFAULT '' `json:$.nas_ip`,
    `op_price` Nullable(Decimal(12, 6)) `json:$.op_price`,
    `tp_price` Nullable(Decimal(12, 6)) `json:$.tp_price`,
    `cost_in` Nullable(Decimal(12, 6)) `json:$.cost_in`,
    `cost_out` Nullable(Decimal(12, 6)) `json:$.cost_out`,
    `op_currency` LowCardinality(String) DEFAULT '' `json:$.op_currency`,
    `tp_currency` LowCardinality(String) DEFAULT '' `json:$.tp_currency`,
    `extra_attributes` String DEFAULT '{}' `json:$.extra_attributes`

ENGINE "MergeTree"
ENGINE_PARTITION_KEY "toYYYYMM(event_timestamp)"
ENGINE_SORTING_KEY "dataset_id, op_name, tp_name, normalized_status, country, event_timestamp, message_row_id"
