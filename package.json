{
  "name": "mc-qos-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Telecom Messaging QoS Intelligence & MediaCore CSV Analytics Platform",
  "scripts": {
    "dev": "node scripts/run-platform.mjs dev",
    "dev:web": "next dev",
    "build": "next build",
    "build:all": "npm run worker:build && next build",
    "start": "node scripts/run-platform.mjs start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "worker:dev": "node --env-file=.env worker/node_modules/tsx/dist/cli.mjs watch worker/src/index.ts",
    "worker:build": "npm --prefix worker run build",
    "worker:start": "node --env-file=.env worker/dist/worker/src/index.js",
    "tinybird:setup": "node scripts/setup-tinybird.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@clickhouse/client": "^1.11.0",
    "@neon/config": "^1.14.1",
    "@neon/env": "^2.1.4",
    "@neon/functions": "^0.11.0",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-table": "^8.21.2",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "csv-parse": "^5.6.0",
    "echarts": "^5.6.0",
    "jose": "^6.0.10",
    "lucide-react": "^0.475.0",
    "next": "^15.3.0",
    "pg": "^8.13.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.3.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
