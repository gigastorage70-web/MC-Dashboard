# ==============================================================================
# Telecom QoS Intelligence & MediaCore CSV Analytics Platform
# Zero-Docker Default Configuration (SQLite + DuckDB + Local Disk Storage)
# ==============================================================================

NODE_ENV=development
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-32-byte-random-hex-secret
WORKER_WEBHOOK_URL=http://127.0.0.1:4001/trigger
WORKER_WEBHOOK_SECRET=replace-with-shared-hmac-secret

# --- Application DB: 'sqlite' (Zero-Docker built-in) or 'postgres' ---
APP_DB_MODE=sqlite
SQLITE_PATH=./data/app.sqlite
DATABASE_URL=

# --- Analytical DB: 'duckdb' (Zero-Docker columnar OLAP) or 'clickhouse' ---
ANALYTICS_ENGINE=duckdb
DUCKDB_PATH=./data/analytics.duckdb
DUCKDB_SERVER_URL=http://127.0.0.1:4001
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=mc_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# --- Object Storage: 'local' (Zero-Docker) or 'r2' / 'tigris' ---
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./data/storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=mc-csv-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- Worker Settings ---
QUEUE_MODE=appdb
WORKER_PORT=4001
WORKER_BATCH_SIZE=10000
WORKER_POLL_INTERVAL_MS=3000

# --- Privacy ---
DEFAULT_MASK_PII=false
